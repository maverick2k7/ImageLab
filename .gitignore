# ImageLab — gitignore
# Binaries and generated output files

# --- Compiled executables ---
imagelab
imagelab.exe
run_tests
run_tests.exe
make_images
make_images.exe

# --- Object files ---
*.o
*.obj

# --- Generated output images (prefix out_) ---
out_*.png
out_*.bmp
out_*.jpg
out_*.tga

# --- Generated project save ---
imagelab_project.png

# --- Generated CSV experiment results ---
results_*.csv

# --- Generated test images (regenerated by make_images) ---
images/*.png
images/*.bmp
images/*.jpg
images/*.tga

# --- IDE / editor folders ---
.vscode/
.idea/
*.suo
*.user

# --- OS junk ---
Thumbs.db
.DS_Store

# --- Build artefacts ---
build/
*.d
